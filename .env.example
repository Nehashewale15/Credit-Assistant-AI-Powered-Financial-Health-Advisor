# Google Gemini API Key (Get from https://aistudio.google.com/)
GEMINI_API_KEY=

# Backend Database Connection String (SQLite by default, PostgreSQL ready)
DATABASE_URL=sqlite:///./credit_assistant.db

# JWT Secret Key for Session Authentication
SECRET_KEY=credit_assistant_secret_key_2026_super_secure_college_project

# Token expiration (in minutes, 1440 = 24 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=1440
